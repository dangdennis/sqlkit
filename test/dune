; Three stanzas, split by what each suite links, so `--with-test` on an opam
; build of a single package runs that package's suites. test_generated needs
; example/generated (workspace-local, no package), so it runs in the dev
; workspace only.

(tests
 (names
  test_sqlkit
  test_sqlstate
  test_interval
  test_value_row
  test_containers
  test_result_contract)
 (package sqlkit)
 (libraries sqlkit ptime))

(tests
 (names
  test_parse
  test_typemap
  test_pg_type
  test_config
  test_run
  test_resolve_render
  test_snapshot)
 (package sqlkit-postgresql)
 (deps render_golden.ml.expected render_golden.mli.expected)
 (libraries sqlkit_gen unix))

(tests
 (names test_generated test_structured_errors)
 (libraries sqlkit generated ptime uuidm decimal yojson))

(test
 (name test_pgwire)
 (package sqlkit-pgwire)
