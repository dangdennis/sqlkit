# This file is generated by dune, edit dune-project instead
opam-version: "2.0"
version: "0.1.0"
synopsis: "Native Eio driver for sqlkit on libpq's asynchronous API"
description: """
Runs generated queries over libpq without blocking the domain: fibers wait
 on the connection's socket through Eio. Pooled, pipelined, with full
 diagnostics, COPY and server-side cancellation. libpq still owns the
 protocol, authentication and TLS."""
maintainer: ["Dennis Dang"]
authors: ["Dennis Dang"]
license: "MIT"
homepage: "https://github.com/dangdennis/sqlkit"
doc: "https://github.com/dangdennis/sqlkit"
bug-reports: "https://github.com/dangdennis/sqlkit/issues"
depends: [
  "dune" {>= "3.20"}
  "ocaml" {>= "5.5.0"}
  "sqlkit" {= version}
  "sqlkit-postgresql" {= version}
  "sqlkit-pool-eio" {= version}
  "eio" {>= "1.0"}
  "eio_main" {with-test}
  "odoc" {with-doc}
]
build: [
  ["dune" "subst"] {dev}
  [
    "dune"
    "build"
    "-p"
    name
    "-j"
    jobs
    "@install"
    "@runtest" {with-test}
    "@doc" {with-doc}
  ]
]
dev-repo: "git+https://github.com/dangdennis/sqlkit.git"
x-maintenance-intent: ["(latest)"]
