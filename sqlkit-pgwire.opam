# This file is generated by dune, edit dune-project instead
opam-version: "2.0"
version: "0.1.0"
synopsis: "Pure OCaml PostgreSQL driver for sqlkit, over Eio"
description: """
Speaks the PostgreSQL wire protocol directly: no libpq and no C stubs of
 its own. SCRAM-SHA-256, MD5 and password authentication, TLS, pipelined
 prepare, COPY, full diagnostics and cancellation."""
maintainer: ["Dennis Dang"]
authors: ["Dennis Dang"]
license: "MIT"
homepage: "https://github.com/dangdennis/sqlkit"
doc: "https://github.com/dangdennis/sqlkit"
bug-reports: "https://github.com/dangdennis/sqlkit/issues"
depends: [
  "dune" {>= "3.20"}
  "ocaml" {>= "5.5.0"}
  "sqlkit" {= version}
  "sqlkit-pool-eio" {= version}
  "eio" {>= "1.0"}
  "tls-eio" {>= "2.0.0"}
  "ca-certs" {>= "1.0.0"}
  "x509" {>= "1.0.0"}
  "domain-name" {>= "0.4.0"}
  "mirage-crypto-rng" {>= "2.0.0"}
  "digestif" {>= "1.2.0"}
  "base64" {>= "3.5.0"}
  "eqaf" {>= "0.9"}
  "uri" {>= "4.0.0"}
  "eio_main" {with-test}
  "odoc" {with-doc}
]
build: [
  ["dune" "subst"] {dev}
  [
    "dune"
    "build"
    "-p"
    name
    "-j"
    jobs
    "@install"
    "@runtest" {with-test}
    "@doc" {with-doc}
  ]
]
dev-repo: "git+https://github.com/dangdennis/sqlkit.git"
x-maintenance-intent: ["(latest)"]
